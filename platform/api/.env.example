ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/unified_vps
SESSION_SECRET=replace-with-a-random-48-byte-secret
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-before-starting
BOOTSTRAP_TOKEN=replace-with-one-time-bootstrap-token
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=5
AUTO_CREATE_SCHEMA=false
COMMAND_LEASE_SECONDS=900
COMMAND_MAX_ATTEMPTS=5
HEARTBEAT_OFFLINE_SECONDS=120
MAX_PAGE_SIZE=100
