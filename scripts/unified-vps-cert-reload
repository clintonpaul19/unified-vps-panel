#!/usr/bin/env bash
set -u

# Keep the ACME source certificate/key root-owned. Xray receives dedicated
# copies under its service directory.
mkdir -p /usr/local/etc/xray/certs
chown root:root /usr/local/etc/xray/certs 2>/dev/null || true
chmod 755 /usr/local/etc/xray/certs 2>/dev/null || true

if [ -s /etc/unified-vps/xray.crt ]; then
  chmod 0644 /etc/unified-vps/xray.crt 2>/dev/null || true
  install -o xray -g xray -m 0644 /etc/unified-vps/xray.crt /usr/local/etc/xray/certs/xray.crt.tmp 2>/dev/null     && mv -f /usr/local/etc/xray/certs/xray.crt.tmp /usr/local/etc/xray/certs/xray.crt 2>/dev/null || true
fi
if [ -s /etc/unified-vps/xray.key ]; then
  chmod 0600 /etc/unified-vps/xray.key 2>/dev/null || true
  install -o xray -g xray -m 0640 /etc/unified-vps/xray.key /usr/local/etc/xray/certs/xray.key.tmp 2>/dev/null     && mv -f /usr/local/etc/xray/certs/xray.key.tmp /usr/local/etc/xray/certs/xray.key 2>/dev/null || true
fi

# Hysteria uses its own root-owned copy.
if [ -s /etc/unified-vps/xray.crt ]; then
  install -m 0644 /etc/unified-vps/xray.crt /etc/hysteria/server.crt 2>/dev/null || true
fi
if [ -s /etc/unified-vps/xray.key ]; then
  install -m 0640 /etc/unified-vps/xray.key /etc/hysteria/server.key 2>/dev/null || true
fi
chown hysteria:hysteria /etc/hysteria/server.crt /etc/hysteria/server.key 2>/dev/null || true

systemctl try-restart xray.service 2>/dev/null || true
systemctl try-restart hysteria-server.service 2>/dev/null || true
